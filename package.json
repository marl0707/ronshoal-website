{
  "name": "temp_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:danang && npm run check:auth-relay && npm run check:fiction-link && npm run check:ron-3d && npm run check:corporate-analytics && next build",
    "check:ron-3d": "node --test ops/ron-3d-deferred.test.mjs",
    "check:corporate-analytics": "node --test ops/corporate-analytics.test.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:danang": "node ops/danang/build.mjs",
    "check:fiction-link": "node ops/check-fiction-link.mjs",
    "check:auth-relay": "node --experimental-strip-types ops/check-auth-relay.mjs",
    "publish:app-co-creation": "bash ops/app-co-creation/publish.sh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.460.0",
    "matter-js": "^0.20.0",
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
